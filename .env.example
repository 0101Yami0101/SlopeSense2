# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed or shared.

# --- NASA Earthdata -------------------------------------------------------
# Register: https://urs.earthdata.nasa.gov/users/new
# Then authorise: GESDISC, Alaska Satellite Facility (+ Egress Control), NSIDC
# Unlocks: GPM IMERG rainfall, SMAP soil moisture, GLDAS, MERRA-2, MODIS
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Copernicus Dataspace -------------------------------------------------
# Register: https://dataspace.copernicus.eu
# Unlocks: Sentinel-1 (flood extent, InSAR creep), Sentinel-2 (scars, lakes)
CDSE_USERNAME=
CDSE_PASSWORD=

# --- Copernicus Climate Data Store ---------------------------------------
# Register: https://cds.climate.copernicus.eu
# API key is on your profile page, format: <UID>:<APIKEY> or a plain token
# Unlocks: ERA5, ERA5-Land, CMIP6
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Copernicus Early Warning Data Store (GloFAS) -------------------------
# GloFAS moved off the main CDS. Register: https://ewds.climate.copernicus.eu
# Leave blank until confirmed; scripts fall back to CDSAPI_KEY.
EWDS_URL=https://ewds.climate.copernicus.eu/api
EWDS_KEY=
